# Copy to .env and fill in. Never commit .env.

# --- Database ---
# 5432 and 5433 are commonly taken by other local projects, so Recoup
# defaults to 5434. Change both lines together if you override it.
RECOUP_DB_PORT=5434
DATABASE_URL=postgresql+psycopg://recoup:recoup@localhost:5434/recoup

# --- Razorpay (TEST MODE ONLY) ---
# Dashboard -> Settings -> API Keys -> Generate Test Key
# Key id must start with rzp_test_. The app refuses to boot on rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard -> Settings -> Webhooks -> the secret you set when creating the webhook.
# Used to verify the X-Razorpay-Signature header. Without it, webhooks are rejected.
RAZORPAY_WEBHOOK_SECRET=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- App ---
APP_ENV=dev

# Quiet hours, enforced in IST. No customer contact inside this window.
# Defaults are 21 and 9; both are optional.
QUIET_HOURS_START=21
QUIET_HOURS_END=9

# Shared secret for the scheduler endpoints (/tasks/*) and for any call that
# sets live=true or force=true. Sent as the X-Recoup-Token header.
# Leave empty for local development; a PRODUCTION process refuses those
# endpoints rather than serving them unauthenticated.
# Generate one with:  python -c 'import secrets; print(secrets.token_urlsafe(32))'
TASKS_TOKEN=
